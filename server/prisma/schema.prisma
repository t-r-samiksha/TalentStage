generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  FREELANCER
  BOTH
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  profile           Profile?
  freelancerProfile FreelancerProfile?

  projects              Project[]
  proposals             Proposal[]
  contractsAsClient     Contract[] @relation("ClientContracts")
  contractsAsFreelancer Contract[] @relation("FreelancerContracts")

  userSkills UserSkill[]

  notifications Notification[]

  messages Message[]

  sentInvitations Invitation[] @relation("ClientInvitations")

  receivedInvitations Invitation[] @relation("FreelancerInvitations")

  followers ClientFollower[] @relation("ClientFollowers")

  following ClientFollower[] @relation("FreelancerFollowing")
}

model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique
  fullName  String?
  bio       String?
  avatarUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FreelancerProfile {
  id          String @id @default(uuid())
  userId      String @unique
  hourlyRate  Int?
  totalEarned Int    @default(0)
  rating      Float  @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id   String @id @default(uuid())
  name String @unique

  userSkills UserSkill[]
}

model UserSkill {
  id       String  @id @default(uuid())
  userId   String
  skillId  String
  verified Boolean @default(false)
  score    Int?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Project {
  id          String        @id @default(uuid())
  clientId    String
  title       String
  description String
  budgetMin   Int
  budgetMax   Int
  status      ProjectStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  proposals Proposal[]
  contracts Contract[]

  invitations Invitation[]
}

model Proposal {
  id           String         @id @default(uuid())
  projectId    String
  freelancerId String
  coverLetter  String
  bidAmount    Int
  timelineDays Int
  status       ProposalStatus @default(PENDING)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer User    @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([projectId, freelancerId])
}

model Contract {
  id           String         @id @default(uuid())
  projectId    String
  clientId     String
  freelancerId String
  status       ContractStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id])

  client User @relation("ClientContracts", fields: [clientId], references: [id])

  freelancer User @relation("FreelancerContracts", fields: [freelancerId], references: [id])

  milestones Milestone[]

  messages Message[]
}

model Milestone {
  id         String          @id @default(uuid())
  contractId String
  title      String
  amount     Int
  status     MilestoneStatus @default(PENDING)

  submissionText String?

  submissionFileUrl String?

  submittedAt DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(uuid())

  userId String

  title String

  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id String @id @default(uuid())

  contractId String

  senderId String

  content String

  attachmentUrl String?

  attachmentType String?

  createdAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Invitation {
  id String @id @default(uuid())

  projectId String

  clientId String

  freelancerId String

  status InvitationStatus @default(PENDING)

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  client User @relation("ClientInvitations", fields: [clientId], references: [id], onDelete: Cascade)

  freelancer User @relation("FreelancerInvitations", fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([projectId, freelancerId])
}

model ClientFollower {
  id String @id @default(uuid())

  clientId String

  freelancerId String

  createdAt DateTime @default(now())

  client User @relation("ClientFollowers", fields: [clientId], references: [id], onDelete: Cascade)

  freelancer User @relation("FreelancerFollowing", fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([clientId, freelancerId])
}
